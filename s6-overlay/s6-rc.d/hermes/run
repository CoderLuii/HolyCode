#!/command/with-contenv sh
opencode_home="/home/opencode"

exec s6-setuidgid opencode env \
  HOME="$opencode_home" \
  USER="opencode" \
  LOGNAME="opencode" \
  XDG_CONFIG_HOME="$opencode_home/.config" \
  XDG_CACHE_HOME="$opencode_home/.cache" \
  XDG_DATA_HOME="$opencode_home/.local/share" \
  XDG_STATE_HOME="$opencode_home/.local/state" \
  API_SERVER_ENABLED=true \
  API_SERVER_HOST="${API_SERVER_HOST:-0.0.0.0}" \
  API_SERVER_PORT="${HERMES_PORT:-8642}" \
  HERMES_HOME="${HERMES_HOME:-$opencode_home/.hermes}" \
  hermes gateway run --no-supervise --accept-hooks
